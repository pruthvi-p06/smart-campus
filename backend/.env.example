# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Extra allowed frontend origin (localhost:5173/5174/3000 are already allowed)
CLIENT_URL=http://localhost:5174

# ---------- MongoDB Atlas (REQUIRED) ----------
# Atlas > Connect > Drivers. URL-encode special characters in the password.
MONGO_URI=mongodb+srv://<YOUR_USERNAME>:<YOUR_PASSWORD>@<YOUR_CLUSTER_URL>/<YOUR_DATABASE_NAME>?retryWrites=true&w=majority

# ---------- Authentication (REQUIRED) ----------
# At least 16 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# ---------- Administrator accounts ----------
# Secret code needed on the "Create admin account" page. If left empty, admin
# self-registration is disabled (admins can then only be created by an existing admin
# or with: node createAdmin.js).
ADMIN_INVITE_CODE=

# Used only by: node createAdmin.js  (optional first-admin bootstrap)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Chatbot (optional) ----------
# Leave empty to use the built-in campus guide replies. Never put this key in the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_EXPIRE=7d
# Optional: configure only if the AI assistant is enabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<YOUR_USERNAME>:<YOUR_PASSWORD>@<YOUR_CLUSTER_URL>/<YOUR_DATABASE_NAME>

# JWT Secret
JWT_SECRET=your_jwt_secret_placeholder_replace_with_actual_secret


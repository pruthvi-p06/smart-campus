# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/smartcampus

# JWT Configuration
JWT_SECRET=smartcampus_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRE=7d

# Optional External AI API Key (Gemini / OpenAI)
# If omitted or offline, the system automatically uses the built-in campus AI heuristic engine
GEMINI_API_KEY=
